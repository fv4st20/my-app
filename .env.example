# ==============================================================================
# Swiss Knife Hub — Production Environment Configuration Template
# ==============================================================================
# 1. Copy this file to `.env` and restrict permissions:
#      cp .env.example .env && chmod 600 .env
# 2. Generate a strong cryptographic secret (256-bit / 64 hex chars) and set SECURITY_SECRET:
#      openssl rand -hex 32
#    Or using Node.js (cross-platform):
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. NEVER commit `.env` to version control or share your production secret.
# ==============================================================================

# Runtime mode (`production` or `development`)
NODE_ENV=production

# Internal HTTP port Express listens on
PORT=3000

# Host bind interface (used by Docker Compose `ports:` on the host, or directly by `server.js` on bare-metal/PM2).
# Keep `127.0.0.1` when behind Nginx or Caddy on the same VPS so Docker does not bypass UFW.
# Note: `docker-compose.yml` overrides `BIND_HOST=0.0.0.0` inside the container automatically so Docker port forwarding and `swiss-knife-tor` can reach Express.
BIND_HOST=127.0.0.1

# Public domain or subdomain (e.g. `yourdomain.com` or `hub.yourdomain.com`).
# Leave empty (`DOMAIN=`) when running locally on localhost.
DOMAIN=

# Optional Tor v3 Hidden Service hostname (e.g. `your56charv3address...onion`).
# Retrieve after `docker compose up -d`:
#   docker exec swiss-knife-tor cat /var/lib/tor/hidden_service/hub/hostname
# When set alongside HTTPS `DOMAIN`, clearnet HTML responses emit `Onion-Location` for Tor Browser.
ONION_DOMAIN=

# REQUIRED IN PRODUCTION: Master cryptographic secret (minimum 32 random bytes / 64 hex chars)
# Used by security.js, database.js, and quantumCrypto.js to encrypt/authenticate clearance
# tokens (`z340_clearance`), session tokens (`astra_session`), and anti-cheat HMAC challenges.
# Replace below with output of: openssl rand -hex 32
SECURITY_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Optional custom file path for the JSON database store.
# Defaults to `./data/hub_db.json` (bare-metal/PM2) or `/app/data/hub_db.json` (Docker).
DB_PATH=
