# Production Nginx Configuration for Swiss Knife Hub
# 1. Replace 'yourdomain.com' with your actual registered domain or subdomain.
# 2. Copy this file on your VPS to /etc/nginx/sites-available/swiss-knife:
#      sudo cp nginx.conf.example /etc/nginx/sites-available/swiss-knife
# 3. Enable it:
#      sudo ln -s /etc/nginx/sites-available/swiss-knife /etc/nginx/sites-enabled/
# 4. Secure with SSL via Certbot:
#      sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com

upstream swiss_knife_backend {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com;

    # Maximum upload size
    client_max_body_size 25M;

    # Gzip Compression for fast delivery of JS/CSS/SVGs
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Static assets caching optimization
    location ~* \.(?:css|js|woff2?|svg|png|jpg|jpeg|gif|ico|webp)$ {
        proxy_pass http://swiss_knife_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    # Main reverse proxy
    location / {
        proxy_pass http://swiss_knife_backend;
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Proxy forwarding headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_cache_bypass $http_upgrade;
    }
}
