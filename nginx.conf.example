# ==============================================================================
# Production Nginx Reverse Proxy Configuration — Swiss Knife Hub
# ==============================================================================
# Setup steps (see VPS_SETUP_GUIDE.md for full walkthrough):
# 1. Obtain your Let's Encrypt certificate first (while default Nginx is running):
#      sudo certbot certonly --nginx -d yourdomain.com -d www.yourdomain.com
# 2. Copy this file and replace `yourdomain.com` with your actual domain:
#      sudo cp nginx.conf.example /etc/nginx/sites-available/swiss-knife
#      sudo sed -i 's/yourdomain.com/YOUR_ACTUAL_DOMAIN.COM/g' /etc/nginx/sites-available/swiss-knife
# 3. Enable site, disable default vhost, verify syntax, and reload:
#      sudo ln -sf /etc/nginx/sites-available/swiss-knife /etc/nginx/sites-enabled/swiss-knife
#      sudo rm -f /etc/nginx/sites-enabled/default
#      sudo nginx -t && sudo systemctl reload nginx
# ==============================================================================

# Preserve HTTP/1.1 upstream keepalive on normal requests while supporting WebSocket upgrades
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# GDPR Data Minimization: anonymize visitor IP addresses in on-disk access logs
# (masks final octet of IPv4 and interface identifier of IPv6)
map $remote_addr $remote_addr_anon {
    ~(?P<ip>\d+\.\d+\.\d+)\.    $ip.0;
    ~(?P<ip>[^:]+:[^:]+:[^:]+): $ip::;
    default                     0.0.0.0;
}

log_format swiss_privacy '$remote_addr_anon - [$time_local] "$request" $status $body_bytes_sent "$http_referer"';

upstream swiss_knife_backend {
    server 127.0.0.1:3000;
    keepalive 32;
}

# HTTP (Port 80) -> Redirect all traffic to HTTPS (except Let's Encrypt HTTP-01 challenges)
server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com;

    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://yourdomain.com$request_uri;
    }
}

# Redirect www -> canonical apex domain over HTTPS to keep Origin & cookies unified
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.yourdomain.com;

    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    return 301 https://yourdomain.com$request_uri;
}

# Primary Hardened HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name yourdomain.com;

    server_tokens off;

    # --- TLS 1.2 / 1.3 Configuration (Mozilla Intermediate) ---
    ssl_certificate           /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    ssl_certificate_key       /etc/letsencrypt/live/yourdomain.com/privkey.pem;
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SwissSSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # Privacy-preserving access log (pair with 7-day logrotate in VPS_SETUP_GUIDE.md)
    access_log /var/log/nginx/swiss-knife.access.log swiss_privacy;
    error_log  /var/log/nginx/swiss-knife.error.log warn;

    # Aligned with server.js `express.json({ limit: '10kb' })` — blocks large payload floods at edge
    client_max_body_size 64k;

    # Gzip compression for text, JSON, JS, CSS, and SVG responses
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # Deduplicate security headers set by Express while ensuring Nginx error responses stay protected.
    # Content-Security-Policy is intentionally passed straight through from server.js.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(self), payment=(), usb=()" always;

    # Allow Let's Encrypt renewal challenges
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Block all hidden dotfiles (.env, .git, .dockerignore, etc.)
    location ~ /\.(?!well-known/) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Quiet healthcheck endpoint (avoids cluttering logs)
    location = /health {
        access_log off;
        proxy_pass http://swiss_knife_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Cache content-hashed Vite sub-app bundles (/neon-orbit/assets/*, /star-locator/assets/*,
    # /chem-lab/assets/*, /chill-hub/assets/*, /shape-wars/assets/*, /sonic-soccer/assets/*,
    # /nond_ex/assets/*, /alien-echo/assets/*, /pirate-fishing/assets/*) privately in browser
    # AFTER Express verifies `z340_clearance` / `astra_session` cookies.
    location ~* ^/(?:neon-orbit|star-locator|chem-lab|chill-hub|shape-wars|sonic-soccer|nond_ex|alien-echo|pirate-fishing)/assets/.+\.(?:css|js|mjs|woff2?|svg|png|jpg|jpeg|gif|ico|webp|wasm)$ {
        proxy_pass http://swiss_knife_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Repeat server-level security headers (Nginx drops parent add_header when location defines add_header)
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(self), payment=(), usb=()" always;
        # No `always` on Cache-Control so 401/302 unverified responses are never cached
        add_header Cache-Control "private, max-age=604800, immutable";
    }

    # Main reverse proxy for Dashboard (`/`), API (`/api/*` incl. GET/POST/DELETE), and all 9 sub-apps
    location / {
        proxy_pass http://swiss_knife_backend;
        proxy_http_version 1.1;

        # Conditional WebSocket upgrade (preserves keepalive on standard HTTP requests)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Proxy forwarding headers (matches `app.set('trust proxy', 1)` in server.js)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_cache_bypass $http_upgrade;
    }
}
